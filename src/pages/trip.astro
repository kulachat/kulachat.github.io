---
// PIN gate for the private trip guide.
// The guide itself is AES-GCM encrypted in src/data/trip.enc.json
// (generated by `npm run trip:encrypt` from the git-ignored trip-source.astro).
import payload from '../data/trip.enc.json';

const digits = 'digits' in payload ? payload.digits : 6;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fbfbfa" />
    <title>Trip · ใส่รหัส PIN</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600&family=Prompt:wght@600&display=swap"
    />
    <style is:global>
      :root {
        --bg: #fbfbfa;
        --surface: #fff;
        --line: #e4e4e0;
        --ink: #111;
        --muted: #4d4d4d;
        --dark: #1b1b1b;
        --danger: #c62828;
        color-scheme: light;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 24px 16px calc(24px + env(safe-area-inset-bottom));
        background: var(--bg);
        color: var(--ink);
        font:
          16px/1.6 'Google Sans',
          system-ui,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .gate {
        width: 100%;
        max-width: 400px;
        padding: 36px 28px 28px;
        background: var(--surface);
        border: 1px solid #eeeeeb;
        border-radius: 30px;
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.03),
          0 14px 40px rgba(0, 0, 0, 0.06);
        text-align: center;
      }
      .badge {
        display: grid;
        place-items: center;
        width: 76px;
        height: 76px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: var(--dark);
        color: #fff;
        font:
          600 24px 'Prompt',
          sans-serif;
      }
      h1 {
        margin: 0;
        font:
          600 26px/1.3 'Prompt',
          sans-serif;
      }
      .lead {
        margin: 6px 0 26px;
        color: var(--muted);
      }
      .pin {
        position: relative;
        display: grid;
        grid-template-columns: repeat(var(--digits), 1fr);
        gap: 10px;
        max-width: 320px;
        margin: 0 auto;
      }
      .pin span {
        display: grid;
        place-items: center;
        aspect-ratio: 1 / 1.15;
        border: 1.5px solid var(--line);
        border-radius: 16px;
        background: #f7f7f5;
        transition:
          border-color 0.15s,
          background 0.15s;
      }
      .pin span::after {
        content: '';
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--ink);
        transform: scale(0);
        transition: transform 0.12s;
      }
      .pin span.filled::after {
        transform: scale(1);
      }
      .pin span.current {
        border-color: var(--ink);
        background: #fff;
      }
      .pin input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        font-size: 16px;
        cursor: text;
      }
      .pin.error span {
        border-color: var(--danger);
      }
      .pin.error {
        animation: shake 0.35s;
      }
      @keyframes shake {
        25% {
          transform: translateX(-8px);
        }
        50% {
          transform: translateX(8px);
        }
        75% {
          transform: translateX(-4px);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .pin.error {
          animation: none;
        }
      }
      .message {
        min-height: 26px;
        margin: 14px 0 4px;
        color: var(--muted);
        font-size: 14px;
      }
      .message.error {
        color: var(--danger);
      }
      .remember {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        color: var(--muted);
        font-size: 14px;
        cursor: pointer;
      }
      .remember input {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: var(--dark);
      }
      button {
        width: 100%;
        min-height: 52px;
        margin-top: 8px;
        border: 0;
        border-radius: 999px;
        background: var(--dark);
        color: #fff;
        font:
          500 16px 'Google Sans',
          system-ui,
          sans-serif;
        cursor: pointer;
      }
      button:disabled {
        opacity: 0.55;
        cursor: default;
      }
      :focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
      }
      .pin:focus-within span.current {
        box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.08);
      }
    </style>
  </head>
  <body>
    <form class="gate" id="gate" autocomplete="off">
      <div class="badge" aria-hidden="true">P&amp;C</div>
      <h1>The Wedding Journal</h1>
      <p class="lead">ใส่รหัส PIN {digits} หลักเพื่อดูแผนการเดินทาง</p>

      <label class="pin" id="pin" style={`--digits:${digits}`}>
        {Array.from({ length: digits }, () => <span aria-hidden="true" />)}
        <input
          id="pin-input"
          type="password"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength={digits}
          autocomplete="one-time-code"
          aria-label={`รหัส PIN ${digits} หลัก`}
          aria-describedby="message"
          autofocus
        />
      </label>

      <p class="message" id="message" role="status" aria-live="polite"></p>

      <label class="remember">
        <input type="checkbox" id="remember" checked />
        จำรหัสไว้ในเครื่องนี้
      </label>
      <button type="submit" id="submit" disabled>เปิดดู Trip</button>
    </form>

    <script
      is:inline
      type="application/json"
      id="trip-data"
      set:html={JSON.stringify(payload)}
    />

    <script is:inline>
      const STORE_KEY = 'trip-pin';
      const form = document.getElementById('gate');
      const pinBox = document.getElementById('pin');
      const input = document.getElementById('pin-input');
      const cells = [...pinBox.querySelectorAll('span[aria-hidden]')];
      const message = document.getElementById('message');
      const remember = document.getElementById('remember');
      const submit = document.getElementById('submit');
      const payload = JSON.parse(
        document.getElementById('trip-data').textContent
      );
      const digits = cells.length;

      function say(text, isError = false) {
        message.textContent = text;
        message.classList.toggle('error', isError);
      }
      function render() {
        const n = input.value.length;
        cells.forEach((c, i) => {
          c.classList.toggle('filled', i < n);
          c.classList.toggle('current', i === Math.min(n, digits - 1));
        });
        submit.disabled = n !== digits;
      }

      const bytes = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
      async function decrypt(pin) {
        const base = await crypto.subtle.importKey(
          'raw',
          new TextEncoder().encode(pin),
          'PBKDF2',
          false,
          ['deriveKey']
        );
        const key = await crypto.subtle.deriveKey(
          {
            name: 'PBKDF2',
            salt: bytes(payload.salt),
            iterations: payload.iterations,
            hash: 'SHA-256',
          },
          base,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt']
        );
        const plain = await crypto.subtle.decrypt(
          { name: 'AES-GCM', iv: bytes(payload.iv) },
          key,
          bytes(payload.data)
        );
        return new TextDecoder().decode(plain);
      }

      function show(html) {
        // Replace the gate with the decrypted page; its inline scripts run as usual.
        document.open();
        document.write(html);
        document.close();
      }

      async function unlock(pin, { auto = false } = {}) {
        submit.disabled = true;
        input.disabled = true;
        say('กำลังเปิด…');
        try {
          const html = await decrypt(pin);
          try {
            if (remember.checked) localStorage.setItem(STORE_KEY, pin);
            else localStorage.removeItem(STORE_KEY);
          } catch (e) {}
          show(html);
        } catch (e) {
          try {
            localStorage.removeItem(STORE_KEY);
          } catch (err) {}
          input.disabled = false;
          input.value = '';
          render();
          input.focus();
          if (!auto) {
            say('รหัสไม่ถูกต้อง ลองใหม่อีกครั้ง', true);
            pinBox.classList.remove('error');
            void pinBox.offsetWidth;
            pinBox.classList.add('error');
          } else {
            say('');
          }
        }
      }

      input.addEventListener('input', () => {
        input.value = input.value.replace(/\D/g, '').slice(0, digits);
        pinBox.classList.remove('error');
        if (message.classList.contains('error')) say('');
        render();
        if (input.value.length === digits) unlock(input.value);
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (input.value.length === digits) unlock(input.value);
      });

      render();
      if (!payload.data) {
        input.disabled = true;
        say('ยังไม่มีข้อมูล Trip', true);
      } else if (!window.crypto?.subtle) {
        input.disabled = true;
        say('เบราว์เซอร์นี้ถอดรหัสไม่ได้ ต้องเปิดผ่าน https', true);
      } else {
        let saved = null;
        try {
          saved = localStorage.getItem(STORE_KEY);
        } catch (e) {}
        if (saved && saved.length === digits) unlock(saved, { auto: true });
      }
    </script>
  </body>
</html>
